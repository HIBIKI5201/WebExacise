<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- JSからC#を呼び出すためのWasm機能の有効化 -->
    <WasmEnableJSInterop>true</WasmEnableJSInterop>
    <!-- 静的アセットのwwwrootへの出力は不要なので無効化 -->
    <EmitWebAssemblyAssetsToSeparatePath>false</EmitWebAssemblyAssetsToSeparatePath>
    <!-- Blazor UIの要素は不要 -->
    <_DisableStaticWebAssets>true</_DisableStaticWebAssets>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
  </PropertyGroup>

  <!-- JS Interopに必要なパッケージのみを保持 -->
  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.1" />
  </ItemGroup>

</Project>
